<%# Enlaces de paginación (paginacion: Paginacion; ruta: lambda que recibe el número de página y da la URL). %>
<% if paginacion.varias? %>
  <nav class="d-flex flex-wrap justify-content-between align-items-center gap-2" aria-label="Páginas" id="paginacion">
    <span class="small text-body-secondary">Página <%= paginacion.pagina %> de <%= paginacion.paginas %></span>
    <ul class="pagination pagination-sm mb-0">
      <li class="page-item <%= "disabled" if paginacion.primera? %>">
        <% if paginacion.primera? %>
          <span class="page-link">Anterior</span>
        <% else %>
          <%= link_to "Anterior", ruta.(paginacion.pagina - 1), class: "page-link", rel: "prev" %>
        <% end %>
      </li>
      <% paginacion.numeros.each do |numero| %>
        <% if numero.nil? %>
          <li class="page-item disabled"><span class="page-link">…</span></li>
        <% elsif numero == paginacion.pagina %>
          <li class="page-item active" aria-current="page"><span class="page-link"><%= numero %></span></li>
        <% else %>
          <li class="page-item"><%= link_to numero, ruta.(numero), class: "page-link", aria: { label: "Página #{numero}" } %></li>
        <% end %>
      <% end %>
      <li class="page-item <%= "disabled" if paginacion.ultima? %>">
        <% if paginacion.ultima? %>
          <span class="page-link">Siguiente</span>
        <% else %>
          <%= link_to "Siguiente", ruta.(paginacion.pagina + 1), class: "page-link", rel: "next" %>
        <% end %>
      </li>
    </ul>
  </nav>
<% end %>
