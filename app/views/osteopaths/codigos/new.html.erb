<% content_for :title, "Código de verificación" %>

<div class="row justify-content-center">
  <div class="col-sm-10 col-md-6 col-lg-4">
    <div class="card text-bg-dark shadow">
      <div class="card-body p-4">
        <h1 class="h4 mb-3 text-center">Código de verificación</h1>
        <p class="small text-body-secondary">
          Escribe el código de 6 cifras que muestra tu app de autenticación. Si no tienes el móvil, puedes usar
          uno de tus códigos de recuperación.
        </p>

        <%= form_with url: codigo_login_path, method: :post, id: "formulario-codigo" do |f| %>
          <div class="mb-4">
            <%= f.label :codigo, "Código", class: "form-label" %>
            <%= f.text_field :codigo, autofocus: true, autocomplete: "one-time-code", maxlength: 11,
                                      spellcheck: false, class: "form-control form-control-lg text-center font-monospace" %>
          </div>
          <%= f.submit "Verificar", class: "btn btn-success w-100" %>
        <% end %>

        <p class="mt-3 mb-0 text-center">
          <%= link_to "Volver al login", new_osteopath_session_path, class: "text-success-emphasis" %>
        </p>
      </div>
    </div>
  </div>
</div>
