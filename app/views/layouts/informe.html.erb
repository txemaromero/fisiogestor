<%# Layout del informe de la visita: tema claro y sin barra de navegación, pensado para imprimirse o
    guardarse como PDF desde el navegador. %>
<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · RedSocialFisios" : "RedSocialFisios" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="informe" data-bs-theme="light">
    <main class="container py-4">
      <%= yield %>
    </main>
  </body>
</html>
