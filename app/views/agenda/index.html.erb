<% content_for :title, "Agenda" %>

<div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-4">
  <h1 class="h3 mb-0">Agenda</h1>
  <span class="text-body-secondary">Sesiones a partir de hoy, <%= l(@hoy, format: :long) %></span>
</div>

<% if @dias.empty? %>
  <div class="alert alert-secondary">
    No hay sesiones programadas a partir de hoy. Para programar una, añádela a un diagnóstico desde su
    visita con una fecha de hoy en adelante.
  </div>
<% else %>
  <% @dias.each do |fecha, sesiones| %>
    <section class="mb-4" id="dia-<%= fecha.iso8601 %>">
      <h2 class="h5">
        <%= dia_agenda(fecha, @hoy) %>
        <span class="badge text-bg-secondary align-middle"><%= pluralize(sesiones.size, "sesión", plural: "sesiones") %></span>
      </h2>
      <div class="table-responsive">
        <table class="table table-dark table-striped align-middle tabla-agenda">
          <thead>
            <tr>
              <th class="columna-paciente">Paciente</th>
              <th class="columna-diagnostico">Diagnóstico</th>
              <th>Técnicas previstas</th>
              <th class="text-center columna-boton">Visita</th>
              <th class="text-center columna-boton">Sesión</th>
            </tr>
          </thead>
          <tbody>
            <% sesiones.each do |sesion| %>
              <% visita = sesion.diagnosis.visit %>
              <tr id="<%= dom_id(sesion) %>">
                <td><%= link_to visita.patient.nombre_completo, visita.patient, class: "link-light" %></td>
                <td>
                  <%= sesion.diagnosis.disease.nombre %>
                  <div class="small text-body-secondary"><%= texto_progreso(sesion.diagnosis) %></div>
                </td>
                <td><%= valor_o_guion(sesion.treatments.map(&:nombre).sort.join(", ")) %></td>
                <td class="text-center"><%= link_to "Ver", visit_path(visita), class: "btn btn-sm btn-success" %></td>
                <td class="text-center">
                  <%= link_to "Editar", edit_sesion_path(sesion), class: "btn btn-sm btn-outline-success",
                                                                  aria: { label: "Editar la sesión de #{visita.patient.nombre_completo}" } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>
  <% if @sesiones.size == AgendaController::MAX_SESIONES %>
    <p class="small text-body-secondary">Se muestran las <%= AgendaController::MAX_SESIONES %> primeras sesiones.</p>
  <% end %>
<% end %>
