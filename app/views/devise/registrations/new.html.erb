<% content_for :title, "Nuevo usuario" %>

<div class="row justify-content-center">
  <div class="col-md-10 col-lg-7">
    <div class="card text-bg-dark shadow">
      <div class="card-body p-4">
        <h1 class="h4 mb-4">Nuevo usuario</h1>

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="row g-3">
            <div class="col-sm-6">
              <%= f.label :nombre, "Nombre", class: "form-label" %>
              <%= f.text_field :nombre, autofocus: true, autocomplete: "given-name", class: clase_campo(resource, :nombre) %>
            </div>
            <div class="col-sm-6">
              <%= f.label :apellidos, "Apellidos", class: "form-label" %>
              <%= f.text_field :apellidos, autocomplete: "family-name", class: clase_campo(resource, :apellidos) %>
            </div>

            <div class="col-12">
              <%= f.label :email, "Email", class: "form-label" %>
              <%= f.email_field :email, autocomplete: "email", class: clase_campo(resource, :email),
                                        aria: { describedby: "ayuda-email" } %>
              <div id="ayuda-email" class="form-text">
                Te enviaremos un correo para confirmarlo: hasta entonces no podrás entrar.
              </div>
            </div>

            <div class="col-sm-6">
              <%= f.label :password, "Clave", class: "form-label" %>
              <%= f.password_field :password, autocomplete: "new-password", class: clase_campo(resource, :password),
                                              aria: { describedby: "ayuda-clave" } %>
              <div id="ayuda-clave" class="form-text">Al menos debe contener <%= @minimum_password_length || 6 %> caracteres.</div>
            </div>
            <div class="col-sm-6">
              <%= f.label :password_confirmation, "Confirmación de la clave", class: "form-label" %>
              <%= f.password_field :password_confirmation, autocomplete: "new-password",
                                                           class: clase_campo(resource, :password_confirmation) %>
            </div>
          </div>

          <div class="d-flex gap-2 mt-4">
            <%= f.submit "Guardar", class: "btn btn-success" %>
            <%= link_to "Cancelar", new_session_path(resource_name), class: "btn btn-outline-light" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
