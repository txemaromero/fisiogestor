<% content_for :title, "Login" %>

<div class="row justify-content-center">
  <div class="col-sm-10 col-md-6 col-lg-4">
    <div class="card text-bg-dark shadow">
      <div class="card-body p-4">
        <h1 class="h4 mb-4 text-center">Login</h1>

        <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
          <div class="mb-3">
            <%= f.label :email, "Usuario (email)", class: "form-label" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
          </div>

          <div class="mb-4">
            <%= f.label :password, "Clave", class: "form-label" %>
            <%= f.password_field :password, autocomplete: "current-password", class: "form-control" %>
          </div>

          <%= f.submit "login", class: "btn btn-success w-100" %>
        <% end %>

        <p class="mt-3 mb-0 d-flex justify-content-between gap-2">
          <%= link_to "¿Nuevo usuario?", new_registration_path(resource_name), class: "text-success-emphasis" %>
          <%= link_to "¿Has olvidado tu clave?", new_password_path(resource_name), class: "text-success-emphasis" %>
        </p>
        <p class="mt-2 mb-0 text-center small">
          <%= link_to "¿No te ha llegado el correo para confirmar tu email?", new_confirmation_path(resource_name),
                      class: "text-success-emphasis" %>
        </p>
      </div>
    </div>
  </div>
</div>
